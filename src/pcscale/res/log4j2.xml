<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <!--
        Ротация pcscale.log: по дате и по размеру (что наступит раньше).
        Архивы pcscale-YYYY-MM-DD-N.log.gz удаляются, если старше 14 дней
        или суммарный размер архивов превышает 50 MB.
    -->
    <Appenders>
        <RollingFile name="FileAppender"
                     fileName="pcscale.log"
                     filePattern="pcscale-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d [%7r] [%t] %6p - %c - %m%n" charset="UTF-8"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="5 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10" compressionLevel="6">
                <Delete basePath="." maxDepth="1">
                    <IfFileName glob="pcscale-*.log.gz"/>
                    <IfAny>
                        <IfLastModified age="14d"/>
                        <IfAccumulatedFileSize exceeds="50 MB"/>
                    </IfAny>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Root level="debug">
            <AppenderRef ref="FileAppender"/>
        </Root>
    </Loggers>
</Configuration>
